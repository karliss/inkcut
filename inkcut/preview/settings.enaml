from enaml.layout.api import hbox, align, spacer
from enaml.widgets.api import Container, Form, Label, CheckBox, SpinBox
from enaml.qt.QtWidgets import QApplication


enamldef PreviewSettingsPage(Container):
    padding = 0
    attr model
    Form:
        Label:
            text = QApplication.translate("settings", "Grid")
        Container:
            constraints = [
                hbox(gx, gy, lb, ga),
                align('v_center', gx, gy, lb, ga)
            ]

            CheckBox: gx:
                text = QApplication.translate("settings", "X")
                checked := model.show_grid_x
            CheckBox: gy:
                text = QApplication.translate("settings", "Y")
                checked := model.show_grid_y
            Label: lb:
                text = QApplication.translate("settings", "Alpha")
            SpinBox: ga:
                value := model.grid_alpha
        Label:
            text = QApplication.translate("settings", "Display")
        Container:
            CheckBox:
                text = QApplication.translate("settings", "Moves")
                checked := model.show_moves
            CheckBox:
                text = QApplication.translate("settings", "Input drawing")
                checked := model.show_drawing
            CheckBox:
                text = QApplication.translate("settings", "Processed path")
                checked := model.show_processed_path
